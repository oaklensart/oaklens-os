.DS_Store
# No trailing slash on purpose: `node_modules/` matches a DIRECTORY only, and
# `os-extract.mjs --verify` puts a node_modules *symlink* in the tree it builds
# (borrowing this repo's packages so the extracted suite can run offline). A
# symlink is a file, so the slashed form let it show up as untracked — and an
# absolute-path symlink committed into a fork would point at a directory on
# somebody else's machine. This form covers both shapes.
node_modules

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
.aider*

# AI-agent worktrees: whole checkouts of this repo, parked inside it. Committing
# one would nest the repo in itself. The per-machine settings file goes with it —
# it records one person's local tool permissions, not the project's.
.claude/worktrees/
.claude/settings.local.json

audit/

# bench -> D1 migration scratch files (never commit / never deploy)
bench.json
bench-remote.json
bench-migrate.sql

# wrangler dry-run build output
dist/
